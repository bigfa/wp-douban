msgstr "深色模式"

msgid "Follow System"
msgstr "跟随系统"

msgid "Custom CSS"
msgstr "自定义CSS"

msgid "Please input valid CSS."
msgstr "请输入合法的CSS。"

msgid "Show Comment"
msgstr "展示短评"

msgid "Show comment and marked date when rendering a single item if it is marked."
msgstr "开启后文章引入单条目时如果标记过则展示短评和标记时间"

msgid "Show Status Tabs"
msgstr "开启分类"

msgid "By default only watched items are shown. Enable this to show want-to-watch / watching / watched."
msgstr "默认只展示看过的条目，开启后会展示想看/在看/看过"

msgid "Render on Home"
msgstr "首页渲染"

msgid "By default links are auto-rendered only on single posts. Enable this to render on non-single pages too."
msgstr "默认只会在文章页自动渲染条目链接，开启后在非文章页也会渲染。"

msgid "Download Images"
msgstr "下载图片"

msgid "Download poster images to local storage."
msgstr "开启后将封面图片下载到本地。"

msgid "Disable Assets"
msgstr "静态文件"

msgid "Do not load plugin bundled CSS/JS."
msgstr "开启后将不加载插件自带的静态文件。"

msgid "Douban Movie Top 250"
msgstr "豆瓣电影Top250"

msgid "Enable to sync the Douban movie <code>top250</code> list periodically and show the <code>top250</code> badge on matched items."
msgstr "开启该选项则会定期同步豆瓣电影<code>top250</code> 清单，当条目在清单中时展示<code>top250</code> 标识。"

msgid "Douban Book Top 250"
msgstr "豆瓣图书Top250"

msgid "Enable to sync the Douban book <code>top250</code> list periodically and show the <code>top250</code> badge on matched items."
msgstr "开启该选项则会定期同步豆瓣图书<code>top250</code> 清单，当条目在清单中时展示<code>top250</code> 标识。"

